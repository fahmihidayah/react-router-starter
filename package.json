{
  "name": "starter-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "react-router build && bun run worker:build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen",
    "test:coverage": "cross-env VITEST_SKIP_INSTALL_CHECKS=true vitest run --coverage",
    "test:coverage:ui": "cross-env VITEST_SKIP_INSTALL_CHECKS=true vitest --ui --coverage",
    "test:coverage:users": "cross-env VITEST_SKIP_INSTALL_CHECKS=true vitest run --coverage app/features/users",
    "test:coverage:watch": "cross-env VITEST_SKIP_INSTALL_CHECKS=true vitest --coverage --watch",
    "db:push": "bun run drizzle-kit push",
    "db:seed": "tsx seeds/index.ts system",
    "db:seed:demo": "tsx seeds/index.ts demo",
    "db:seed:local": "tsx seeds/index.ts local",
    "db:bootstrap-admin": "tsx seeds/index.ts admin",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:drop": "drizzle-kit drop",
    "db:up": "drizzle-kit up",
    "db:reset": "bun run db:drop && bun run db:fresh",
    "db:fresh": "bun run db:push && bun run db:seed:local",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:snapshot": "drizzle-kit generate && bun run db:backup",
    "db:inspect": "tsx scripts/db-inspect.ts",
    "db:validate": "bun run db:check && bun run typecheck",
    "db:setup": "bun run db:generate && bun run db:push && bun run db:seed",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "machine-translate": "inlang machine translate --project project.inlang",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide",
    "worker:build": "esbuild worker/email.worker.ts --bundle --platform=node --format=esm --target=node20 --outfile=build/worker/email.worker.js --packages=external",
    "worker:dev": "tsx worker/email.worker.ts",
    "worker:start": "node build/worker/email.worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/lib-storage": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@hookform/resolvers": "5.2.2",
    "@lexical/code": "0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "0.44.0",
    "@lexical/utils": "0.44.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/fs-routes": "8.5.0",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@sentry/node": "^11.6.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "amqplib": "^2.2.0",
    "better-auth": "1.6.22",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "10.1.0",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "handlebars": "^4.7.10",
    "isbot": "5.1.40",
    "juice": "^12.2.0",
    "lexical": "^0.44.0",
    "lucide-react": "1.14.0",
    "next-themes": "0.4.6",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "react": "^19.2.6",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router": "8.5.0",
    "redis": "^6.3.0",
    "resend": "^6.32.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/cli": "^3.0.0",
    "@inlang/paraglide-js": "^2.20.2",
    "@playwright/test": "1.59.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "16.3.2",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "26.1.0",
    "playwright": "1.59.1",
    "playwright-core": "1.59.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "4.1.5"
  }
}
