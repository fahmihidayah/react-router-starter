# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database
# ============================================
# For SQLite (development)
DB_FILE_NAME=file:./application.db

# For PostgreSQL (production)
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# ============================================
# Better Auth
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production

# Development: http://localhost:5173
# Production: https://your-app.up.railway.app (or your domain)
BETTER_AUTH_URL=http://localhost:5173

# ============================================
# Optional: PostgreSQL Connection (if using docker-compose db service)
# ============================================
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=starter_app
# DB_HOST=db
# DB_PORT=5432

# ============================================
# Media Upload
# ============================================
# local (default) or s3
MEDIA_STORAGE_DRIVER=local

# Local storage
MEDIA_UPLOAD_DIR=./uploads/media
MEDIA_LOCAL_BASE_URL=/api/media/files

# Image processing
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_WEBP_QUALITY=82

# S3 storage (required when MEDIA_STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_MEDIA_PREFIX=media
# Optional for Cloudflare R2, MinIO, DigitalOcean Spaces, or a CDN
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
