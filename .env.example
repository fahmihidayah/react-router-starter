# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database
# ============================================
# Required PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# ============================================
# Admin bootstrap (pnpm db:bootstrap-admin)
# ============================================
# Used only by the bootstrap command above; the repository ships no default administrator.
# Prefer passing these as one-off shell or secret-manager values instead of storing them in .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ============================================
# Better Auth
# ============================================
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production

# Development: http://localhost:5173
# Staging: http://124.156.207.229:3000
# Production: https://catat-progres.fahmihidayah.my.id
BETTER_AUTH_URL=http://localhost:5173

# ============================================
# Optional: Google login
# ============================================
# Create an OAuth 2.0 Web application in Google Cloud and add:
# ${BETTER_AUTH_URL}/api/auth/callback/google
# as an authorized redirect URI.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# Optional: Google reCAPTCHA v2 (checkbox)
# ============================================
# Create a reCAPTCHA v2 "I'm not a robot" site for your domain.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================
# Security and rate limiting
# ============================================
# Defaults to enabled in production and disabled elsewhere when omitted.
RATE_LIMIT_ENABLED=true
# Required only when rate limiting is enabled. REDIS_URL is also accepted as a fallback.
RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Change this when multiple applications share the same Redis database.
RATE_LIMIT_REDIS_PREFIX=learning-tracker:rate-limit
# Headers inspected for the client IP. Only configure headers that your trusted proxy overwrites.
AUTH_IP_HEADERS=x-forwarded-for
# Comma-separated proxy IP addresses or narrow CIDR ranges. Leave empty for a single trusted
# forwarded value. Keep the application origin inaccessible to untrusted direct traffic.
AUTH_TRUSTED_PROXIES=

# ============================================
# Email
# ============================================
# smtp (default) or resend
EMAIL_PROVIDER=smtp
# direct (default) or rabbitmq
EMAIL_DELIVERY_MODE=direct

# Enables the admin-only template test endpoint POST /api/send/email.
# Defaults to enabled outside production and disabled in production.
EMAIL_TEST_ENDPOINT_ENABLED=false

# SMTP settings (used when EMAIL_PROVIDER=smtp)
# SMTP_USER and SMTP_PASSWORD are optional, but must be provided together.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend settings (used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# RabbitMQ settings (used when EMAIL_DELIVERY_MODE=rabbitmq)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# The worker pulls jobs in batches of this size.
RABBITMQ_PREFETCH=5
# Failed jobs are discarded by default. Enable only when retry loops are acceptable.
RABBITMQ_REQUEUE_ON_FAILURE=false
# The queue that email jobs are published to and consumed from.
EMAIL_QUEUE_NAME=emails

EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Learning Tracker
EMAIL_REPLY_TO=support@example.com
EMAIL_SUPPORT_ADDRESS=support@example.com
EMAIL_APP_NAME=Learning Tracker
# Optional absolute URL for a small logo shown in email headers.
EMAIL_LOGO_URL=

# ============================================
# Optional: PostgreSQL Connection (if using docker-compose db service)
# ============================================
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=starter_app
# DB_HOST=db
# DB_PORT=5432

# ============================================
# Media Upload
# ============================================
# local (default) or s3
MEDIA_STORAGE_DRIVER=local

# Local storage
MEDIA_UPLOAD_DIR=./uploads/media
MEDIA_LOCAL_BASE_URL=/api/media/files

# Image processing
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_WEBP_QUALITY=82

# S3 storage (required when MEDIA_STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_MEDIA_PREFIX=media
# Optional for Cloudflare R2, MinIO, DigitalOcean Spaces, or a CDN
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ============================================
# Analytics
# ============================================
# Google Tag Manager web container ID (for example: GTM-ABCDEFG)
# Leave empty to disable GTM. Do not use a GA4 measurement ID (G-...).
GTM_CONTAINER_ID=

# ============================================
# Privacy & Consent
# ============================================
# Enable or disable the cookie consent banner
# Default: true
CONSENT_BANNER_ENABLED=true

# ============================================
# SEO & Indexing
# ============================================
# Allow search engines to index the site
# Set to false to prevent search engine crawling and indexing (robots.txt will disallow all)
# Default: false (indexing disabled by default)
ALLOW_INDEXING=false

# ============================================
# Observability (optional)
# ============================================
# Serve Prometheus metrics from /api/metrics. Requires OBSERVABILITY_METRICS_TOKEN in production.
OBSERVABILITY_METRICS_ENABLED=false
# Minimum 16 characters. Required in production when metrics are enabled.
# Access metrics with: curl -H "Authorization: Bearer YOUR_TOKEN" http://localhost:3000/api/metrics
OBSERVABILITY_METRICS_TOKEN=
# Sentry/GlitchTip DSN for error tracking (https://public-key@your-instance.com/project-id)
# Error tracking is disabled when this is empty.
OBSERVABILITY_SENTRY_DSN=
# Overrides the environment tag in Sentry; falls back to NODE_ENV.
OBSERVABILITY_ENVIRONMENT=
# Release/version string attached to error reports and shown in Sentry.
OBSERVABILITY_RELEASE=
